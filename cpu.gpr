project Cpu is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/");
   for Object_Dir use "obj/";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";

   -- for Main use ("main.c");
   for Main use ("main.adb");

   package Builder is
      -- for Executable ("main.c") use "cpu.out";
      for Executable ("main.adb") use "cpu.out";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use (
         "-gnat2012",
         "-gnatwa",
         "-gnatyy"
      );
   end Compiler;
end Cpu;
